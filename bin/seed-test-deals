#!/usr/bin/env node
// Creates a few test records in the owner's Attio workspace so the live check has deals to read: 2 companies,
// 3 people and 3 deals, every name ending in "(WireCat test)". It reads the token from the keyring entry
// `service attio account <account>`, prints the token's scopes first, and writes nothing without
// record_permission:read-write. Every created record is a row in the status CSV, which `--delete` reads back.
//   bin/seed-test-deals <keyring account>            create (records already in the CSV are skipped)
//   bin/seed-test-deals <keyring account> --delete   delete what the CSV lists
import { spawnSync } from "node:child_process"
import { appendFileSync, existsSync, mkdtempSync, readFileSync, rmSync } from "node:fs"
import { homedir, tmpdir } from "node:os"
import { join } from "node:path"
import { fileURLToPath } from "node:url"

const ROOT = fileURLToPath(new URL("..", import.meta.url))
const CLI = join(ROOT, "dist/bin/attio.js")
const STATUS = join(homedir(), ".local/state/wirecat/attio-seed-test-deals.csv")
const TAG = "(WireCat test)"

const [account, mode] = process.argv.slice(2)
if (!account) {
  process.stdout.write("Usage: bin/seed-test-deals <keyring account> [--delete]\n")
  process.exit(2)
}
const work = mkdtempSync(join(tmpdir(), "attio-seed-"))
const env = {
  ...process.env,
  WCATTIO_CONFIG_DIR: join(work, "config"),
  WCATTIO_STATE_DIR: join(work, "state"),
  WCATTIO_CACHE_DIR: join(work, "cache"),
  MESSAGING_STORE: join(work, "wirecat.db"),
  DBUS_SESSION_BUS_ADDRESS: "disabled:",
}
delete env.WCATTIO_TOKEN
const attio = (args, input) => {
  const out = spawnSync("node", [CLI, "seed", ...args, "--json"], { cwd: ROOT, env, input, encoding: "utf8" })
  const text = out.stdout.trim()
  const json = text ? JSON.parse(text.slice(text.indexOf("{"))) : {}
  if (out.status !== 0 || json.error) {
    const why = `${JSON.stringify(json.error ?? text).slice(0, 400)} ${out.stderr.trim().slice(0, 400)}`
    throw new Error(`${args.slice(0, 2).join(" ")}: ${why}`)
  }
  return json
}
const flags = (options) => Object.entries(options).flatMap(([k, v]) => (v === true ? [`--${k}`] : [`--${k}`, v]))
const api = (command, options, body) =>
  attio(["api", command, ...flags(options), ...(body ? ["--body", "-"] : [])], body && JSON.stringify(body))
const done = () =>
  existsSync(STATUS) ? readFileSync(STATUS, "utf8").trim().split("\n").slice(1).map((line) => line.split(",")) : []
const row = (key, object, id, status) => {
  if (!existsSync(STATUS)) appendFileSync(STATUS, "key,object,id,status,time\n")
  appendFileSync(STATUS, `${key},${object},${id},${status},${new Date().toISOString()}\n`)
}

const lookup = ["lookup", "service", "attio", "account", account]
const token = spawnSync("secret-tool", lookup, { encoding: "utf8" }).stdout.trim()
if (!token) throw new Error(`no keyring entry service attio account ${account}`)
process.stdout.write(`status file: ${STATUS}\n`)
try {
  attio(["session", "start", "--credential-storage", "file"], token)
  const self = api("self-list", {}).item ?? {}
  const scopes = String(self.scope ?? "").split(/\s+/).filter(Boolean)
  process.stdout.write(`token scopes: ${scopes.join(" ") || "(none reported)"}\n`)
  if (!scopes.includes("record_permission:read-write")) {
    process.stdout.write("no record_permission:read-write: nothing written\n")
    process.exitCode = 3
  } else if (mode === "--delete") {
    for (const [key, object, id, status] of done().reverse()) {
      if (status !== "created") continue
      api("objects-records-delete", { object, "record-id": id, yes: true })
      row(key, object, id, "deleted")
      process.stdout.write(`deleted ${key}\n`)
    }
  } else {
    const have = new Map(done().filter(([, , , s]) => s === "created").map(([key, , id]) => [key, id]))
    const create = (key, object, values) => {
      if (have.has(key)) return have.get(key)
      const recordOf = (answer) => (answer?.item?.result?.data ?? answer?.item?.data ?? {}).id?.record_id
      const title = values.name[0].value ?? values.name[0].full_name
      const filter = object === "people" ? { name: { full_name: { $eq: title } } } : { name: { $eq: title } }
      const found = api("objects-records-query", { object }, { filter, limit: 1 })
      const existing = found.item?.data?.[0]?.id?.record_id
      const made = existing ? undefined : api("objects-records-create", { object }, { data: { values } })
      const id = existing ?? recordOf(made)
      if (!id) throw new Error(`${key}: no record id in the answer`)
      row(key, object, id, "created")
      have.set(key, id)
      process.stdout.write(`${existing ? "found" : "created"} ${key}\n`)
      return id
    }
    // The token's own member owns the test deals.
    const me = self.authorized_by_workspace_member_id
    const members = me ? api("workspace-members-list", {}) : {}
    const owner = (members.item?.data ?? []).find((one) => one.id?.workspace_member_id === me)?.email_address
    const answer = api("attributes-statuses-list", { target: "objects", identifier: "deals", attribute: "stage" })
    const list = answer.items ?? answer.item?.data ?? answer.data ?? []
    const stages = list
      .filter((one) => !one.is_archived)
      .map((one) => one.title)
    if (stages.length < 2) throw new Error(`the deals' stage has ${stages.length} statuses`)
    const company = (key, name) => create(key, "companies", { name: [{ value: `${name} ${TAG}` }] })
    const person = (key, first, last, email) =>
      create(key, "people", {
        name: [{ first_name: first, last_name: last, full_name: `${first} ${last} ${TAG}` }],
        email_addresses: [{ email_address: email }],
      })
    const northwind = company("company-northwind", "Northwind Traders")
    const bluebird = company("company-bluebird", "Bluebird Labs")
    const anna = person("person-anna", "Anna", "Petrova", "anna.petrova@example.com")
    const marco = person("person-marco", "Marco", "Rossi", "marco.rossi@example.com")
    const lena = person("person-lena", "Lena", "Novak", "lena.novak@example.org")
    const deal = (key, name, stage, amount, people, companyId) =>
      create(key, "deals", {
        name: [{ value: `${name} ${TAG}` }],
        stage: [stage],
        ...(owner ? { owner: [owner] } : {}),
        value: [amount],
        associated_people: people.map((id) => ({ target_object: "people", target_record_id: id })),
        associated_company: [{ target_object: "companies", target_record_id: companyId }],
      })
    process.stdout.write(`stage titles: ${stages.join(" | ")}; owner: ${owner ? "yes" : "no"}\n`)
    deal("deal-northwind-renewal", "Northwind annual renewal", stages[0], 12000, [anna], northwind)
    deal("deal-northwind-expansion", "Northwind expansion", stages[1], 4500, [anna, marco], northwind)
    deal("deal-bluebird-pilot", "Bluebird pilot", stages.at(-1), 8000, [lena], bluebird)
    process.stdout.write(`stages used: ${stages[0]}, ${stages[1]}, ${stages.at(-1)}\n`)
  }
} finally {
  try {
    attio(["session", "end"])
  } catch {}
  rmSync(work, { recursive: true, force: true })
}
